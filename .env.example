# Copy to .env (gitignored) and fill in. Never commit .env or paste these values into chat.

# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Supabase → Connect → Connection string → "Session pooler" (IPv4; the direct host does not work from GitHub Actions)
DATABASE_URL=postgresql://postgres.<project-ref>:<database password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# data.go.kr Decoding key for the 관세청 APIs
KCS_API_KEY=

# Optional: free key from comtradeplus.un.org (lifts the 500-row preview cap)
COMTRADE_API_KEY=
